{
  "name": "@quote24x7/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quote24x7 operational console — independent Site24x7 pricing assistant (internship project, not an official Zoho or Site24x7 product).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/server/**/*.test.ts\"",
    "catalogue:build": "node scripts/build-catalogue-seed.mjs",
    "check": "npm run catalogue:build && npm run lint && npm run typecheck && npm run test",
    "benchmark": "node --env-file=.env.local --experimental-strip-types scripts/run-benchmark.ts",
    "benchmark:rules": "node --experimental-strip-types scripts/run-benchmark.ts --provider rules",
    "benchmark:export": "node --experimental-strip-types scripts/run-benchmark.ts --export-dataset benchmark-dataset-v1.json",
    "mail:preview": "echo 'Start the dev server (npm run dev) then visit http://localhost:3000/api/v1/preview?threadId=<ID>&type=quote|clarification'",
    "diag:inbound": "node --experimental-strip-types scripts/diag-inbound.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "5.104.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mammoth": "^1.13.0",
    "motion": "14.1.1",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "tailwind-merge": "3.3.1",
    "xlsx": "^0.18.5",
    "zod": "4.1.12",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
