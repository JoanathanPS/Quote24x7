const navSearchInput = document.getElementById('nav-search-input')
const navWrapper = document.querySelector('.navigation .wrapper')

const navNoResults = document.createElement('p')
navNoResults.className = 'nav-no-results'
navNoResults.textContent = 'No items matched.'
navNoResults.style.display = 'none'
navWrapper?.after(navNoResults)

function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}

function highlightNavItem(li, term) {
    const target = li.querySelector('span.name a') || li.querySelector('span.name')
    if (!target) return
    const text = target.textContent
    const idx = text.toLowerCase().indexOf(term)
    if (idx === -1) return
    target.dataset.origHtml = target.innerHTML
    const before = escapeHtml(text.slice(0, idx))
    const match = escapeHtml(text.slice(idx, idx + term.length))
    const after = escapeHtml(text.slice(idx + term.length))
    target.innerHTML = `${before}<mark class="nav-search-highlight">${match}</mark>${after}`
}

function clearNavHighlights() {
    navWrapper?.querySelectorAll('[data-orig-html]').forEach(el => {
        el.innerHTML = el.dataset.origHtml
        delete el.dataset.origHtml
    })
}

if (navSearchInput && navWrapper) {
    navSearchInput.addEventListener('input', function () {
        const term = this.value.trim().toLowerCase()

        clearNavHighlights()
        navWrapper.querySelectorAll('li, div.sub-menu').forEach(el => el.style.display = '')
        navWrapper.querySelectorAll('ul').forEach(ul => { ul.style.display = ''; ul.style.maxHeight = '' })
        navWrapper.classList.remove('in-search')
        navNoResults.style.display = 'none'

        if (!term) return

        navWrapper.classList.add('in-search')
        navWrapper.querySelectorAll('li').forEach(li => li.style.display = 'none')

        let matchCount = 0

        navWrapper.querySelectorAll('li:not(.category)').forEach(li => {
            if (li.textContent.trim().toLowerCase().includes(term)) {
                li.style.display = ''
                highlightNavItem(li, term)
                matchCount++

                let node = li.parentElement
                while (node && node !== navWrapper) {
                    if (node.tagName === 'UL') { node.style.display = 'block'; node.style.maxHeight = 'none' }
                    if (node.classList.contains('sub-menu')) {
                        node.style.display = 'block'
                        const catLi = node.previousElementSibling
                        if (catLi?.classList.contains('category')) catLi.style.display = ''
                    }
                    node = node.parentElement
                }
            }
        })

        navWrapper.querySelectorAll('li.category').forEach(li => {
            if (li.textContent.trim().toLowerCase().includes(term)) {
                li.style.display = ''
                highlightNavItem(li, term)
                matchCount++
                const subMenu = li.nextElementSibling
                if (subMenu?.classList.contains('sub-menu')) {
                    subMenu.style.display = 'block'
                    const ul = subMenu.querySelector('ul')
                    if (ul) { ul.style.display = 'block'; ul.style.maxHeight = 'none' }
                    subMenu.querySelectorAll('li').forEach(child => child.style.display = '')
                }
            }
        })

        navNoResults.style.display = matchCount === 0 ? '' : 'none'
    })
}
//ignorei18n_end

