//ignorei18n_start
document.querySelectorAll('.content a[href]').forEach(link => {
  const rawHref = link.getAttribute('href');
  if (!rawHref || /^(#|mailto:|tel:|javascript:)/i.test(rawHref)) return;
  // Use the anchor's own parsed URL parts rather than rebuilding the href string,
  // and only ever assign the query string -- the scheme can never be changed here.
  if (!/^https?:$/.test(link.protocol)) return;
  if (link.origin !== window.location.origin && !/(^|\.)(site24x7|manageengine)\.com$/i.test(link.hostname)) return;
  const params = new URLSearchParams(link.search);
  if (params.has('src')) return;
  params.set('src', 'crosslink');
  params.set('pg', 'help');
  link.search = params.toString();
});
//ignorei18n_end

