y functional.","help.assistant.route53.healthcheck.content.2":"<a href=\"{{help}}/aws/route53-healthcheck-integration.html\" target =\"_blank\">Learn more<\/a>","alibabacloud_ecs.networkoutrate":"Network Out Rate","ec2.cwagent.filesystem":"File System","plugin.http.302.error.msg":"The requested resource resides temporarily under a different URI","alibabacloud_rds.pgsharedbufferhitcount":"PostgreSQL Shared Buffer Hit Count","gcp.auto.mg.info":"Auto create monitor group for GCP Organization and associate the GCP Projects and Resources in their respective sub-groups.","mongodbatlas.node.max.system.normalized.cpu.steal":"Max System Normalized CPU Steal","nw.hardware.fan.sensor.down":"Alert when the Fan Sensor Status is Down","max.huaweicloud_dcaas_vintf.usage":"Max","kube.container.ephemeralstorage.capacity":"Container Ephemeral Storage Capacity","client.user.alert.management":"User & Alert Management","forecast.toggle.tooltip":"Click Zia icon to enable/disable forecasted values.","vmware.vdi.hv.sessions.disconnected.state":"Sessions in Disconnected State","committed.nvidia.l4.gpus.per":"Committed Nvidia L4 Gpus Per Project Region","s3.modified.object.count.graph.title":"Number Of Objects Modified in Last 5 minutes","msp.saml.auth.info":"SAML helps to enable Single Sign-On (SSO) for web applications from your identity providers.","gateway.stage.api.cache":"API Cache","proxmox.resource.add":"Add Proxmox Resource","global.unit.id":"ID","help.assistant.sqs.title.1":"Simple Queue Service(SQS)","help.assistant.sqs.title.2":"Support queue types","winbackup.vss.down.reason":"Volume Shadow Service is Down","of365.tab.m365.apps.usage":"M365 Apps Usage","huaweicloud_obs.request_code_count":"Request Code Distribution","backup.bytes":"Backup To S3 - Bytes","oci.help.assistant.waf.subtitle":"Oracle Cloud Infrastructure Web Application Firewall (OCI WAF) protects web applications from threats like SQL injection, cross site scripting, and bots by filtering incoming traffic. Site24x7 integrates with OCI WAF to provide centralized visibility into traffic, security events, and policy activity through a single dashboard.","huaweicloud_elb.l4_ncps_usage":"L4 New Connection Per Second Usage","saas.application.gitlab.web.credential.info":"The credential profile helps to ensure enhanced security. Save your Gitlab Sign-In credentials as a profile and then use them for your monitors. For configuration instructions, please refer to the <a href=\"https://www.site24x7.com/help/admin/configuration-profiles/credential-profile.html\">help documentation<\/a>.","alarms-msp.list.tour.6.filter-acknowledged.right":"<div><h5>Filter acknowledged<\/h5><div>Filter all the alarms in the page by using status and acknowledgement.<\/div><\/div>","az.title.disks.diskstate":"Disk State","apminsight.reqcount":"Req. Count","neptune.cluster.associated.roles":"Associated Roles","server.memory.page.out.mp":"Outward Memory Pages","global.checking.process":"Checking...","apminsight.app.alert.peak.thread.count.exceeds":"Peak thread count of application {{n0}}","dynamodb.reports.avg.system.errors":"System Errors","oci.key.id":"Key OCID","kube.operator.help.link.cr.configuration":"Site24x7K8s CR configurations","apm.autoprofiler.rules.empty.info":"Create an <a href=\"{{help}}/apm/autoprofiler/process-monitoring-rules.html\" target=\"_blank\" rel=\"noopener\">APM Process Monitoring Rule<\/a> to monitor Application processes.","plugin.app.sap_abap.report.max.buf.field.description.swap":"Max Field Description - Swaps","cl.nw.interfaces.criteria.dosent.match":"It looks like the criteria for bulk update did not match with any existing interfaces","ds.memory.occupied.units":"Disk Space Occupied","dc.smtp.fail.inval-add":"The SMTP failure was due to an invalid email address.","practice.azure.vm.use.data.disk.for.app.data.desc":"Use data disks for storing application data.","apminsight.jvm.tableview.row.total":"Total","digitalocean.oauth2.provider.name":"Provider name","nsx.node.swap.memory.us