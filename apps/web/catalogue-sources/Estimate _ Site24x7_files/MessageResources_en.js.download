lobal.threshold.regex":"Matches","reports.average.elb.backend":"Average Backend Errors","practice.aws.s3.buckets.policies.allow.only.ssl.info.desc":"<p><b>Baseline : <\/b><\/p><p> Determines if your S3 bucket policies are only allowing requests with SSL or not.<\/p><p><b>Description : <\/b><\/p><p> S3 buckets must be configured to strictly require SSL connections. If not, the connection between users, applications, and these buckets will be vulnerable to eavesdropping and man-in-the-middle (MITM) attacks.<\/p><p><b>Recommendation : <\/b><\/p><p> While dealing with sensitive data, enforce SSL-only access by denying all HTTP requests without SSL to your buckets.<\/p>","huaweicloud_apic.group.throughput":"Throughput Metrics","alibabacloud_apsaradb_lindorm.lindormmultisolrupdatep999rt":"Lindorm Multi SOLR Update P999 RT","cl.nf.discovery.chooseDev":"Choose Devices","predefined.report.44.name":"K8s Deployment Status","cl.nw.bgp.peer.message.received.history":"BGP Peer Total Messages Received History","vc.rp.cpu.unreserv.vm.max":"Max Cpu Unreserved for VM","azure.errorcode.11404":"Azure Resource is Removed.","mysql.ndb.node.monitor.add":"Add MySQL NDB Node Monitor","aws.dlm.ebs.snapshot.snapshots.shared.failed":"Snapshots Shared Failed","postgresql.metric.autovacuumanalyzethreshold.desc":"Autovacuum analyze threshold","errorcode.solution.configure.host":"Check if the IP address or domain name of the host is configured correctly.","alibabacloudsas.title.wmrawtable":"Simple Application Server","reports.netflow.qos":"QoS Report","nsx.firewall.category":"Firewall Category","global.aws.msk.topic.monitortype":"MSK Topic","ncm.compliance.edit.policy.success":"Policy Updated Successfully!","oauth2.resource.owner.password.credentials.tooltip":"Provide the Resource Owner's username and password.","server.service.stype.threshold.mp":"Service Start Mode","amazon.ebsvolume.avail.monitortype":"EBS Volume","alibabacloud_analyticsdb_mysql.executoravgcpuused":"Executor Average CPU Used","