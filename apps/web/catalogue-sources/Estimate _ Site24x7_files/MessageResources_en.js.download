ailable.","ds.memory.allocated":"Memory Allocated","sdn.celona.edge.memory.capacity":"Memory Capacity","global.tags":"Tags","benchmarks.widget.set.country":"Set as My Country","mongodbatlas.cluster.mongodb.version":"MongoDB Version","alibabacloud_rds.pg_backend_iothroughput":"PostgreSQL Backend IO Throughput","ebs.max.autoscale.group":"Max Autoscale Groups","alibabacloud_oss.qos_get_bucket_max_send_flow":"Qos Get Bucket Max Send Flow","oci.private.key.size.error":"File exceeds maximum size of 500KB.","alibabacloud_ehpc.offlinenodenumbyqueue":"Offline Node Number by Queue","dns.newmonitor.timeout":"The socket connection to the DNS server must be established within this duration.","global.transactional.email.footer.text":"\n\n---------------------------\n\n$COMPANYNAME\n\nYou are receiving this transactional email because you have an account with $COMPANYNAME. For assistance, please contact your account administrator within your organization, $ADMIN. If you have any other queries, you can reach out to our support team at $SUPPORT_EMAIL. Refer the link for more info on transactional emails $TRANSACTIONAL_LINK .","zia.recommendations.evidence":"Generated based on:","add.azure.resource.vault":"Add Azure Key Vault","ca.version.tab":"Versions","nsx.loadbalancer.l4.current.session.rate":"L4 Current Session Rate","kube.has.ld":"Has Leader","alert.sqlagreplica.db.ssd":"Synchronization State: \"{{n0}}\".","alibabacloud_rds.mysql_qps":"MySQL QPS (Queries Per Second)","aws.agentcore.harness.edit":"Edit Bedrock AgentCore Harness","sdn.citrixSdwan.customer":"Customers","sdn.common.avg.connected.clients":"Avg Connected Clients","xen.cpu.speed":"SPEED","practice.kinesis.server.side.encryption.info.desc":"<p><b>Baseline : <\/b><\/p><p>Checks for Amazon Kinesis Data Streams where Server-side-encryption (SSE) is disabled.<\/p><p><b>Description : <\/b><\/p><p>Encryption at rest plays a crucial part in data management and helps your application meet strict compliance and regulatory requirements. By enabling server-side encryption you data gets automatically encrypted as it enters and decrypted as it leaves the stream service.<\/p><p><b>Recommendation : <\/b><\/p><p>Enable Server-side-encryption for you live stream using the Amazon Key Management (KMS) keys.<\/p>","pdf.download.quote":"Download Quote","dm.databricks.col.cleanup_duration":"Avg Cleanup Duration","azure.next.hop":"Next Hop","huaweicloud_gaussdb.gaussdb_mysql371_taurus_binlog_total_file_counts":"Binlog Files","al.db.vpn.suc.topusername":"Top Successful VPN Logons based on Users","udp.newmonitor.timeout":"The time to get a response from the server.","azure.metric.tempdiskwriteoperationssec.desc":"Temp Disk Write Operations/Sec","hyperv.rootvirtual.hlt.instructions":"HLT Instructions","oracle.db.listener.inbound.connect.timeout":"Inbound Connect Timeout","maintenance.monitors.popup.description":"View the list of all monitors that are currently under maintenance. Snooze maintenance of selected monitors during the current maintenance window without affecting the overall maintenance configuration.","metrics.configuration.header":"Configuration Metatdata","cl.dhcp.max.total.ip":"Maximum Pool Size","practice.dynamodb.on.demand.backup.and.restore.desc":"Checks for Amazon DynamoDB tables with no backups in the last 30 days","datalake.checking.status":"Checking...","aws.redshift.query.throughput.medium":"Medium latency","ncm.compliance.policy.save.label":"Save Policy","global.threshold.strategy":"Poll Strategy","alibabacloud_polardb.opensearchfsiototalwriteoperations":"OpenSearch FS IO Total Write Operations","al.ri.timerange":"Time Range","neptune.gremlin.websocket.server.errors":"Gremlin WebSocket Server Errors","huaweicloud_dds.tab.replication":"Replication","security.policy.advanced.rules.edge":"Security Policy Advanced Rules per Edge Security Policy","oci.waf.firewall.add":"Add WAF Firewall Monitor","alibabacloud_alb.loadbalancerqps":"Load Balancer QPS","plugin.app.glassfish.filecache.maxmap