sap_abap.metric.spool.service.queue.pages":"Spool Service Queue Pages","practice.gcp.sql.disable.contained.db.auth.info.desc":"<p><b>Baseline : <\/b><\/p><p>Checks if the contained database authentication is disabled for SQL Server instances.<\/p><p><b>Description : <\/b><\/p><p>Contained database authentication stores user credentials within the database itself rather than in the server's master database. This can create security risks, including potential credential exposure and challenges with centralized authentication management.<\/p><p><b>Recommendation : <\/b><\/p><p>Turn off contained database authentication for your CloudSQL SQL Server instances by setting the <i>contained database authentication<\/i> flag to <b>off<\/b> in order to keep centralized control over authentication.<\/p>","server.disk.totalsize":"Overall Disk Size","oci.instance.pool.stopped.reason":"Instance Pool is in Stopped status.","cl.nw.l2.view.connections":"View Connections","server.monitor.monitor.conf.label.windows":"Next Steps: Thresholds, Services, Plugins, Logs & more","amazon.vpc.endpoint.type":"Type","dashboard.resource.type.info":"Choose the desired Resource Type.","oracle.db.metric.openresetlogs.desc":"Open Reset Logs","cl.dhcp.server.name":"Server Name","cl.nw.ucs.fabric_extender.server.portsoper.stateup":"Fabric Extender Server Portsoper Stateup","aws.rds.proxy.database.connections.currently.in.transaction":"Database Connections Currently In Transaction","cl.recommendation.custom.alerts.title":"Use incident parameters and custom parameters to send personalized alerts","al.lprof.source.remotefile":"Remote File","azure.over.provision":"Over Provision","azure.metric.sessionscount.desc":"Sessions count","client.amazon.warning.delete":"You are attempting to delete the Amazon monitor. If you proceed further, all your related AWS monitors will be removed permanently. To stop discovery, you can edit the Rediscovery Interval to \"Never\" instead.","js.directory.path.empty":"Directory p