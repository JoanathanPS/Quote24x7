include:<\/b><\/p><ul><li><b>Complete Flow Logs<\/b>: Capture all Pod traffic, including intra-node.<\/li><li><b>Uniform Firewall Rules<\/b>: Apply rules to all Pod communication.<\/li><li><b>Full Traffic Inspection<\/b>: Mirror and analyze all traffic, even intra-node.<\/li><\/ul><\/p><p><b>Recommendation : <\/b><\/p><p>Enable intranode visibility on your GKE clusters to monitor and secure intranode pod traffic using VPC flow logs and tools.<\/p>","plugin.edit.template.tip":"Click here to edit Plugin Template","apminsight.threads.tableview.column.peakthreads":"Peak threads","oci.app.time.updated":"Last Updated","az.title.expressroute.tab.qos":"Circuit QoS","cl.wlc.ap.admin.status.down.alert":"Alert if the number of Monitored Access Points with Down Admin Status exceeds the configured limit","glue.crawler.version":"Version","alibabacloud_waf.qps-wafv3":"QPS (WAFv3)","oci.apigw.http.requests":"HTTP Requests","global.rearm.threshold.label":"ReArm Threshold","mssql.elc.history":"Error Log Files Count History","global.fetch.responsetime":"IMAP/POP Response Time","global.action.template.tag.14.desc":"Group name of the Monitor","pdf.modes":"Purchase Order/Credit Card/Paypal Account","kube.failed.pods":"Failed Pods","cl.nw.ucs.chassis_port.monitor":"Chassis Port Monitor","device.template.table.label":"Table","azure.loc.australiacentral2":"(Asia Pacific) Australia Central 2","oci.basedb.nodes.state":"State","azure.exproute.gateway":"Azure ExpressRoute Gateway","cl.server.aupg.skip.down":"Upgrade Skipped: Agent unreachable. Unable to send upgrade request to agent.","s3.endpoint.content.type":"Content Type","esx.datastore.type":"Type","pdf.footer.string":"Generated Date:","aws.workspace.avg.session.disconnect":"Average Session Disconnect","add.contact.userrole.ws.admin":"Digital Risk Analyzer Admin","vmware.health.dashboard.top.snapshot.age":"Top 10 Snapshots by Age","websites.status.duration":"Duration","oracle.db.metric.pgausedmem.desc":"PGA Used Memory","cl.nw.san.cifs.nam