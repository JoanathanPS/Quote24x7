cl.nw.trap.processor.condition.all":"All the Conditions","practice.dynamodb.on.demand.backup.and.restore.info.desc":"<p><b>Baseline : <\/b><\/p><p>Checks for Amazon DynamoDB tables with no backups in the last 30 days.<\/p><p><b>Description : <\/b><\/p><p>Data archival is a key aspect in long term data retention and regulatory compliance requirements. Amazon DyanomDB lets you create full backups for you tables in seconds and restore data anytime with zero impact on application performance or availability.<\/p><p><b>Recommendation : <\/b><\/p><p>Execute the backup and restore operations for your DynamoDB tables using the AWS management console or DynamoDB APIs.<\/p>","vmware.vdi.vd.pcoip.general.rx.packets.lost":"Received Packets Lost","r53.healthcheck.summary.tab":"Health Check Summary","avm.latest.vulnerability.info":"Displays the 10 most recently discovered vulnerabilities for the selected time period.","client.ebs.volume.snap.title":"EBS Volume Snapshots","aws.drs.replicated.storage.bytes":"Total Replicated Storage (GiB)","saas.application.clickUp.web.credential":"ClickUp Sign-In Credentials","global.disable.agent.based.action":"Disable Agent based IT Automation","practice.aws.drs.replication":"Elastic Disaster Recovery - Data replication","rdspi.db.sql.stats.total.logical.writes.per.call":"Total Logical Writes per Call","alibabacloud_rds.mysql_innodbrowread":"MySQL InnoDB Row Read","db.cache.size.exceeds":"Cache Size","target.pools":"Target Pools","amazon.rdspi.os.memory.instanceid.text":"OS Memory Instance ID","alibabacloud_apsaradb_clickhouse.clickhouse_kafka_total_cc":"Kafka Total (CC)","azure.entra.id.certificate.expired":"Expired Certificates","practice.gcp.sql.disable.public.ips":"Cloud SQL - Public IP enabled SQL instances","global.subtitle.sla":"SLA","azure.next.hop.type":"Next hop type","alibabacloud_rds.pg_startup_iothroughput":"PostgreSQL Startup IO Throughput","huaweicloud_nosql_mongo.monitor.type":"Huawei Cloud GeminiDB Mongo","huaweicloud_er.instanc