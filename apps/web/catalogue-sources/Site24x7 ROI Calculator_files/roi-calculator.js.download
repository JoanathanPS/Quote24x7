    function formatValue(value) {
        if (value >= 1000000000) {
            return `${(value / 1000000000).toFixed(2)}B`;
        } else if (value >= 1000000) {
            return `${(value / 1000000).toFixed(2)}M`;
        } else if (value >= 1000) {
            return `${(value / 1000).toFixed(2)}K`;
        } else {
            return `${value}`;
        }
    }

    function evaluateFormula(formula, metrics) {
        try {
            const sortedMetrics = Object.keys(metrics).sort((a, b) => b.length - a.length);
            sortedMetrics.forEach(metric => {
                const value = metrics[metric];
                const regex = new RegExp(`\\b${metric}\\b`, 'g');
                formula = formula.replace(regex, value);
            });
            if (/^[0-9+\-*/().\s]+$/.test(formula)) {
                return new Function(`"use strict"; return (${formula})`)();
            } else {
                throw new Error('Unsafe characters in formula');
            }
        } catch (e) {
            return null;
        }
    }
    function updateMetricsAndRecalculate(updates) {
        for (let sheetName in data) {
            const sheet = data[sheetName];
            const metrics = {};
            sheet.forEach(entry => {
                metrics[entry.Metric] = entry.Value;
            });

            updates.forEach(({ metric, value }) => {
                sheet.forEach(entry => {
                    if (entry.Metric === metric) {
                        entry.Value = value;
                        metrics[metric] = value;
                    }
                });
            });

        }

        for (let sheetName in data) {
            const sheet = data[sheetName];
            const metrics = {};

            sheet.forEach(entry => {
                metrics[entry.Metric] = entry.Value;
            });

            let recalculated = true;
            while (recalculated) {
                recalculated = false;
                sheet.forEach(entry => {
                    if (entry.Formula) {
                        const newValue = evaluateFormula(entry.Formula, metrics);
                        if (newValue !== null && !isNaN(newValue) && newValue !== metrics[entry.Metric]) {
                            entry.Value = newValue;
                            metrics[entry.Metric] = newValue;
                            recalculated = true;
                        }
                    }
                });
            }

        }
    }
    function calculateTotalCostSavings(data) {
        let totalCostSavings = {
            'enhance-availability': 0,
            'speed-up-product-delivery': 0,
            'improve-bussiness-performance': 0,
            'reduce-observability-costs': 0,
            'total': 0
        };

        for (let sheetName in data) {
            let category = null;
            if (sheetName.startsWith('enhance-availability')) {
                category = 'enhance-availability';
            } else if (sheetName.startsWith('speed-up-product-delivery')) {
                category = 'speed-up-product-delivery';
            } else if (sheetName.startsWith('improve-bussiness-performance')) {
                category = 'improve-bussiness-performance';
            } else if (sheetName.startsWith('reduce-observability-costs')) {
                category = 'reduce-observability-costs';
            }

            if (category) {
                const sheet = data[sheetName];
                sheet.forEach(entry => {
                    if (entry.Metric === 'cost savings' && entry.Value !== null) {
                        totalCostSavings[category] += entry.Value;
                        totalCostSavings.total += entry.Value;
                    }
                });
            }
        }

        return {
            "enhance-availability": totalCostSavings['enhance-availability'],
            "speed-up-product-delivery": totalCostSavings['speed-up-product-delivery'],
            "improve-bussiness-performance": totalCostSavings['improve-bussiness-performance'],
            "reduce-observability-costs": totalCostSavings['reduce-observability-costs'],
            "total": totalCostSavings.total
        };
    }

    function updateAndRenderZohoChart(newValues) {

        function normalizeLabelBack(normalizedLabel) {
            return normalizedLabel.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
        }
        let allValuesAreZero = Object.values(newValues).every(value => value === 0);
        if (allValuesAreZero) {
            chartObj.seriesdata[0].data[0] = [];
        } else {
            let updatedData = [];

            for (let normalizedLabel in newValues) {
                if (normalizedLabel != "total") {
                    let label = normalizeLabelBack(normalizedLabel);
                    let value = newValues[normalizedLabel];
                    updatedData.push([label, value]);
                }
            }

            chartObj.seriesdata[0].data[0] = updatedData;
        }
        chartObj.redraw();
    }


    function calculate() {
        const annualRevenue = getAbsoluteValue('annualRevenue');
    const annualOutages = getAbsoluteValue('annualOutages');
    const mttrMinutes = getAbsoluteValue('mttr');
    const cloudSpend = getAbsoluteValue('cloudSpend');
    const observabilityCosts = getAbsoluteValue('observabilityCosts');
        updateMetricsAndRecalculate([
            { metric: 'annual revenue', value: annualRevenue },
            { metric: 'annual number of unplanned outages', value: annualOutages },
            { metric: 'average mean time to repair of an unplanned outage', value: mttrMinutes },
            { metric: 'current cloud spend', value: cloudSpend },
            { metric: 'current observability costs', value: observabilityCosts }

        ]);


        const totalCostSavings = calculateTotalCostSavings(data);
        // updateAndRenderZohoChart(totalCostSavings)
        // document.getElementById('enhance-availability').lastChild.nodeValue = `${formatValue(totalCostSavings["enhance-availability"])}`;
        // document.getElementById('speed-up-product-delivery').lastChild.nodeValue = `${formatValue(totalCostSavings["speed-up-product-delivery"])}`;
        // document.getElementById('improve-bussiness-performance').lastChild.nodeValue = `${formatValue(totalCostSavings["improve-bussiness-performance"])}`;
        // document.getElementById('reduce-observability-costs').lastChild.nodeValue = `${formatValue(totalCostSavings["reduce-observability-costs"])}`;
        $('#final-savings .amount').text(`${formatValue(totalCostSavings.total)}`);
        $('#final-savings').removeClass('d-none');
        return totalCostSavings
    }

