        const validators = {
            name: value => value.trim() === '' ? 'Name is required.' : '',
            email: value => /^\S+@\S+\.\S+$/.test(value.trim()) ? '' : 'Enter a valid email address.',
            company: value => value.trim() === '' ? 'Company name is required.' : '',
            country: value => value.trim() === '' ? 'Country is required.' : ''
            // phone: value => value.trim() === '' || /^[0-9+\-\s]{7,15}$/.test(value.trim()) ? '' : 'Enter a valid phone number.'
        };

        function validateField($field) {
            const id = $field.attr('id');
            const value = $field.val();
            const $feedback = $field.siblings('.invalid-feedback');
            const error = validators[id](value);

            if (error) {
            $field.addClass('is-invalid');
            $feedback.text(error).show();
            return false;
            } else {
            $field.removeClass('is-invalid');
            $feedback.text('').hide();
            return true;
            }
        }

        $('#roi-form input').on('input blur', function () {
            validateField($(this));
        });


        $('#roi-form').submit(function (e) {
            e.preventDefault(); 

            let isValid = true;

            $('#roi-form input').each(function () {
                if (!validateField($(this))) {
                    isValid = false;
                }
            });

            if (isValid) {
                let totalCostSavings = calculate();
                submitForm(totalCostSavings);
            }
        });

        function submitForm(totalCostSavings) {
        
                const annualRevenue = Number(document.getElementById('annualRevenue').value);
                const annualOutages = Number(document.getElementById('annualOutages').value);
                const mttrMinutes = Number(document.getElementById('mttr').value);
                const cloudSpend = Number(document.getElementById('cloudSpend').value);
                const observabilityCosts = Number(document.getElementById('observabilityCosts').value);
                
                const description = `ROI Calculator Results
Inputs:
- Annual Revenue: $${formatValue(annualRevenue)}
- Annual Outages: ${annualOutages}
- MTTR: ${mttrMinutes} minutes
- Cloud Spend: $${formatValue(cloudSpend)}
- Observability Costs: $${formatValue(observabilityCosts)}

Outputs:
- Downtime reduction savings: $${formatValue(totalCostSavings['enhance-availability'])}
- Faster delivery impact: $${formatValue(totalCostSavings['speed-up-product-delivery'])}
- Cloud optimization gains: $${formatValue(totalCostSavings['improve-bussiness-performance'])}
- Tool consolidation and observability savings: $${formatValue(totalCostSavings['reduce-observability-costs'])}
- Total Savings: $${formatValue(totalCostSavings.total)}`;
    
            const formData = {
                firstName: $('#name').val(),
                email: $('#email').val(),
                company: $('#company').val(),
                country: $('#country').val(),
                leadSource: "roiCalculator",
                description: description,
                downtimeReductionSavings: totalCostSavings['enhance-availability'],
                fasterDeliverySavings: totalCostSavings['speed-up-product-delivery'],
                cloudOptimizationSavings: totalCostSavings['improve-bussiness-performance'],
                observabilitySavings: totalCostSavings['reduce-observability-costs']
            };
            $.ajax({
                url: '/tools/marketing/addLead',
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded',
                data: $.param(formData),
                success: function (response) {
                    // console.log('Form submitted successfully:', response);
                },
                error: function (xhr, status, error) {
                    // console.error('Error submitting form:', error);
                }
            });    }

    initializeControls();
});



