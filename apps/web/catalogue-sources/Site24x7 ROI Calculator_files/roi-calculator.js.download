$(document).ready(function () {
    // === Input/Slider Helpers ===
    function getAbsoluteValue(inputId) {
        const input = $(`#${inputId}-input`);
        const unit = $(`#${inputId}-unit`);
        if (!unit.length) {
            return parseFloat(input.val() || 0);
        }
        return parseFloat(input.val() || 0) * parseInt(unit.val());
    }

    function setInputFromAbsolute(inputId, absoluteValue) {
        const input = $(`#${inputId}-input`);
        const unit = $(`#${inputId}-unit`);
        if (!unit.length) {
            input.val(Math.round(absoluteValue));
            return;
        }
        const currentUnit = parseInt(unit.val());
        let displayValue = absoluteValue / currentUnit;
        // If displayValue is an integer, don't show decimals
        if (Number.isInteger(displayValue)) {
            input.val(displayValue);
        } else {
            input.val(displayValue.toFixed(2));
        }
    }

    function validateInput(inputId) {
        const slider = $(`#${inputId}`);
        const input = $(`#${inputId}-input`);
        const container = $(`#${inputId}-container`);
        const errorMsg = $(`#${inputId}-error`);
        const absoluteValue = getAbsoluteValue(inputId);
         const minValue = parseInt(slider.attr('min')) || 0;
        const maxValue = parseInt(slider.attr('max'));

        if (absoluteValue > maxValue) {
            container.addClass('error');
            input.addClass('error');
            errorMsg.removeClass('d-none');
            setInputFromAbsolute(inputId, maxValue);
            slider.val(maxValue);
            updateRangeBackground(slider);
            return false;
        } 
        else if (absoluteValue <= minValue) {
            setInputFromAbsolute(inputId, minValue);
            slider.val(minValue);
            updateRangeBackground(slider);
            return false;
       }
        
        else {
            container.removeClass('error');
            input.removeClass('error');
            errorMsg.addClass('d-none');
            return true;
        }
    }

    function autoUpgradeUnit(inputId) {
        const input = $(`#${inputId}-input`);
        const unit = $(`#${inputId}-unit`);
        if (!unit.length) {
            return false;
        }

        const inputValue = parseFloat(input.val() || 0);
        const currentUnit = parseInt(unit.val());
        const unitOptions = [];
        unit.find('option').each(function() {
            unitOptions.push(parseInt($(this).val()));
        });
        unitOptions.sort((a, b) => a - b);

        let unitChanged = false;
        if (inputValue >= 1000) {
            const currentIndex = unitOptions.indexOf(currentUnit);
            if (currentIndex < unitOptions.length - 1) {
                const nextUnit = unitOptions[currentIndex + 1];
                unit.val(nextUnit);
                const newInputValue = (inputValue * currentUnit) / nextUnit;
                input.val(newInputValue.toFixed(2));
                updateStep(inputId)
                updateInputMax(inputId);
                unitChanged = true;
            }
        } else if (inputValue < 1 && inputValue > 0) {
            const currentIndex = unitOptions.indexOf(currentUnit);
            if (currentIndex > 0) {
                const prevUnit = unitOptions[currentIndex - 1];
                unit.val(prevUnit);
                const newInputValue = (inputValue * currentUnit) / prevUnit;
                input.val(newInputValue.toFixed(prevUnit === 1000 ? 0 : 2));
                updateStep(inputId)
                updateInputMax(inputId);
                unitChanged = true;
            }
        }
        return unitChanged;
    }

    function updateInputMax(inputId) {
        const input = $(`#${inputId}-input`);
        const unit = $(`#${inputId}-unit`);
        const slider = $(`#${inputId}`);
        if (!unit.length) {
            return;
        }
        const sliderMax = parseInt(slider.attr('max'));
        const currentUnit = parseInt(unit.val());
        const inputMax = Math.floor(sliderMax / currentUnit);
        input.attr('max', inputMax);
        const currentValue = parseFloat(input.val());
        if (currentValue > inputMax) {
            input.val(inputMax);
        }
    }
    function updateRangeBackground($rangeInput) {
        var value = $rangeInput.val();
        var $tooltip = $rangeInput.closest('.range-bar').find('.tooltip-customize');
        $tooltip.text(formatValue(value));
        $rangeInput.closest('.range-box').find('.val-num').text(`${formatValue(value)}`);
        var percentage = (value - $rangeInput.attr('min')) / ($rangeInput.attr('max') - $rangeInput.attr('min')) * 100;
        $rangeInput.css('background', `linear-gradient(to right, #0c201d ${percentage}%, #ddd ${percentage}%)`);
    }


    function syncInputToSlider(inputId) {
        if (validateInput(inputId)) {
            const absoluteValue = getAbsoluteValue(inputId);
            $(`#${inputId}`).val(absoluteValue);
            updateRangeBackground($(`#${inputId}`));
        }
    }

    function syncSliderToInput(inputId) {
        const sliderValue = $(`#${inputId}`).val();
        setInputFromAbsolute(inputId, sliderValue);
        autoUpgradeUnit(inputId);
    }

      const stepConfigInput = {
        annualRevenue: {
        "1000000": 10,      // 10M
        "1000000000": 0.01  // 0.01B = 10M
        },
        cloudSpend: {
        "1000": 500,         // 500K
        "1000000": 0.5,      // 0.5M
        "1000000000": 0.0005 // 0.0005B = 0.5M
        },
        observabilityCosts: {
        "1000": 10,     // 10K
        "1000000": 0.01 // 0.01M = 10K
        }
    };

    const stepConfigRange = {
        annualRevenue: 10000000,
        annualOutages: 10,
        mttr: 10,
        cloudSpend: 500000,
        observabilityCosts: 10000
    };

    function updateStep(inputId) {
        const unit = $(`#${inputId}-unit`).val();
        const $input = $(`#${inputId}-input`);
        if (stepConfigInput[inputId] && stepConfigInput[inputId][unit] !== undefined) {
        $input.attr("step", stepConfigInput[inputId][unit]);
        }
    }
    let previousValues = {};
    function initializeControls() {
        $('input[type="range"]').each(function () {
            const $rangeInput = $(this);
            const inputId = $rangeInput.attr('id');
             if (!previousValues[inputId]) {
                previousValues[inputId] = parseFloat($rangeInput.val());
            }
            syncSliderToInput(inputId);
            updateRangeBackground($rangeInput);
            updateStep(inputId)
            updateInputMax(inputId);
            $rangeInput.on("mousedown", function () {
                $rangeInput.attr("step", stepConfigRange[inputId]);
            });

            // Keyboard interaction
            $rangeInput.on("keydown", function (e) {
                if (e.key === "ArrowRight" || e.key === "ArrowUp") {
                    $rangeInput.attr("step", stepConfigRange[inputId]);
                }
                if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
                    $rangeInput.attr("step", stepConfigRange[inputId]);
                }
            });
                $rangeInput.on('input', function () {
                // let step = stepConfigRange[inputId] || 1;
                // let currentValue = parseFloat($(this).val());
                // let previousValue = previousValues[inputId];
                // let steppedValue;
                // if (currentValue > previousValue) {
                //     steppedValue = previousValue + step;
                // } else if (currentValue < previousValue) {
                //     steppedValue = previousValue - step;
                // }
                // let roundedValue = Math.round(steppedValue / step) * step;

                // $(this).val(roundedValue);
                // previousValues[inputId] = roundedValue;
                syncSliderToInput(inputId);
                updateRangeBackground($rangeInput);
            });

            $(`#${inputId}-input`).on('input', function () {
                $(`#${inputId}`).attr("step", "any");
                const container = $(`#${inputId}-container`);
                const input = $(`#${inputId}-input`);
                const errorMsg = $(`#${inputId}-error`);
                container.removeClass('error');
                input.removeClass('error');
                errorMsg.addClass('d-none');
                autoUpgradeUnit(inputId);
                
                syncInputToSlider(inputId);
                 //$(`#${inputId}`).attr("step", stepConfigRange[inputId]);
            });

            $(`#${inputId}-input`).on('blur', function () {
                validateInput(inputId);
            });

            $(`#${inputId}-unit`).on('change', function () {
                $(`#${inputId}`).attr("step", stepConfigRange[inputId]);
                updateStep(inputId);
                updateInputMax(inputId);
                syncInputToSlider(inputId);
            });
        });

        $('.custom-increase button').on('click', function () {
            
            const target = $(this).data('target');
            const $slider = $(`#${target}`);
            $slider.attr("step", stepConfigRange[target]);
            let step = stepConfigRange[target] || 1;
                
            const isPlus = $(this).hasClass('plus');
            const currentValue = parseInt($slider.val());
            const min = parseInt($slider.attr('min'));
            const max = parseInt($slider.attr('max'));
            let newValue = isPlus ? Math.min(max, currentValue + step) : Math.max(min, currentValue - step);
            let roundedValue = Math.round(newValue / step) * step;
            $slider.val(roundedValue);
            syncSliderToInput(target);
            updateRangeBackground($slider);
        });

        $('.reset-btn').on('click', function () {
            $('.val-input-container').removeClass('error');
            $('.val-input').removeClass('error');
            //$('.error-message').addClass('d-none');
            $('input[type="range"]').each(function () {
                const $rangeInput = $(this);
                 const inputId = $rangeInput.attr('id');
                $rangeInput.attr("step", stepConfigRange[inputId]);
                const defaultValue = $rangeInput.attr('value');
                $rangeInput.val(defaultValue);
               
                syncSliderToInput(inputId);
                updateRangeBackground($rangeInput);
            });
        });
    }


    $('input[type="range"]').each(function () {
        var $rangeInput = $(this);
        var $tooltip = $rangeInput.closest('.range-bar').find('.tooltip-customize');

        updateRangeBackground($rangeInput);
        function updateRangeAndTooltip() {
            // Calculate the position of the tooltip
            var rangeWidth = $rangeInput.width();
            var thumbWidth = 20; // Adjust if your thumb width differs
            var tooltipWidth = $tooltip.outerWidth();
            var value = $rangeInput.val();
            var left = ((value - $rangeInput.attr('min')) / ($rangeInput.attr('max') - $rangeInput.attr('min'))) * (rangeWidth - thumbWidth) + (thumbWidth / 2) - (tooltipWidth / 2);

            $tooltip.css({
                'left': left + 'px'
            });

            updateRangeBackground($rangeInput);
            // calculate();
        }

        // Update tooltip and range fill on input change
        $rangeInput.on('input', updateRangeAndTooltip);

        // Show the tooltip on hover
        $rangeInput.on('mouseenter', function () {
            $tooltip.css('display', 'flex');
            updateRangeAndTooltip(); // Ensure the tooltip is positioned correctly when it appears
        });

        // Hide the tooltip when not hovering
        $rangeInput.on('mouseleave', function () {
            $tooltip.css('display', 'none');
        });


