# ==============================================================================
# Quote24x7 Environment Configuration
# ==============================================================================

# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Verified Sender Address (use 'Quote24x7 <onboarding@resend.dev>' for initial tests,
# or your verified custom domain address e.g. 'Quote24x7 <quotes@yourdomain.com>')
OUTBOUND_FROM_EMAIL="Quote24x7 <quotes@joanathan.in>"

# Inbound Mailbox � the only recipient this pipeline answers.
# Resend's inbound webhook fires for every address on your domain, so mail sent to
# any alias (info@, hello@, etc.) reaches this pipeline. Only mail addressed to the
# mailbox below opens a thread and triggers a quote. Leave unset to default to the
# same mailbox as OUTBOUND_FROM_EMAIL.
INBOUND_TO_EMAIL="quotes@joanathan.in"

# Webhook Signing Secret (from Resend Webhooks settings for inbound / delivery events)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Master switch for live dispatch (must be explicitly 'true' to send real emails)
# Set to 'false' to run in dry-run simulation mode without consuming Resend credits.
ALLOW_EXTERNAL_DISPATCH=true

# Public application base URL (used for generated links and webhooks)
# When deployed on Vercel, this is auto-detected from VERCEL_URL.
# If using a custom production domain, specify here:
# NEXT_PUBLIC_APP_URL=https://quotes.joanathan.in

# Groq API Key for AI Sales Engineer (LPU ultra-fast inference with generous free-tier limits)
# Obtain free from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key for AI Sales Engineer (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Cloud Database Configuration (Persistent storage across Vercel serverless cold starts)
# Obtain from Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for server-side store operations (bypasses RLS safely on backend)
# SECURITY NOTE: Anon key access is completely blocked via RLS for all tables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Sandbox / Testing Recipient Override
# IMPORTANT: If this variable is set, ALL outbound quotes and emails will be redirected
# to this address for safe testing.
# LEAVE EMPTY OR REMOVE THIS VARIABLE IN PRODUCTION (Vercel) to deliver emails to actual buyers!
# TEST_RECIPIENT_EMAIL=your_test_inbox@gmail.com

