# ==============================================================================
# Quote24x7 Environment Configuration
# ==============================================================================

# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Verified Sender Address (use 'Quote24x7 <onboarding@resend.dev>' for initial tests,
# or your verified custom domain address e.g. 'Quote24x7 <quotes@yourdomain.com>')
OUTBOUND_FROM_EMAIL="Quote24x7 <onboarding@resend.dev>"

# Webhook Signing Secret (from Resend Webhooks settings for inbound / delivery events)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Master switch for live dispatch (must be explicitly 'true' to send real emails)
# Set to 'false' to run in dry-run simulation mode without consuming Resend credits.
ALLOW_EXTERNAL_DISPATCH=true

# Public application base URL (used for generated links and webhooks)
# When deployed on Vercel, this is auto-detected from VERCEL_URL.
# If using a custom production domain, specify here:
# NEXT_PUBLIC_APP_URL=https://quote24x7.vercel.app

# Google Gemini API Key for AI Sales Engineer
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: Cloud Database / KV for persistent storage across Vercel cold starts
# (e.g., Upstash Redis or Vercel KV)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
